{
  "id": "film-montage",
  "name": "电影感卡点混剪",
  "description": "一段长片 + 一首歌 → 15-20 秒横版卡点片（自动选段；文字卡由 --title/--credit 决定）",
  "inputs": {
    "source": {
      "type": "video",
      "required": true
    },
    "music": {
      "type": "audio",
      "required": true
    }
  },
  "output": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "container": "mp4"
  },
  "output_kind": "mp4",
  "steps": [
    {
      "id": "analyze",
      "op": "analyze.standard",
      "params": {
        "scene_threshold": 0.25,
        "chorus_window": 30.0
      }
    },
    {
      "id": "shots",
      "op": "select.auto",
      "gate": "confirm",
      "params": {
        "target_seconds": 16
      }
    },
    {
      "id": "cards",
      "op": "card.bookends",
      "params": {}
    },
    {
      "id": "audio",
      "op": "audio.chorus",
      "params": {
        "in": "auto"
      }
    },
    {
      "id": "cleanup",
      "op": "cleanup.crop",
      "params": {
        "crop": "full",
        "crop_bottom": 0
      }
    },
    {
      "id": "normalize",
      "op": "audio.normalize",
      "params": {
        "i": -14.0
      }
    },
    {
      "id": "render",
      "op": "render.edl",
      "params": {}
    },
    {
      "id": "qc",
      "op": "qc.report",
      "params": {}
    }
  ],
  "outputs": [
    "mp4"
  ],
  "capabilities": []
}
